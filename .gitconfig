[user]
    name = Matthew Stiles
    email = git@stiles.dev
    signingkey = B4276497
[commit]
    gpgsign = true
    template = ~/.gitmessage
[core]
    editor = nvim
[push]
    default = simple
    autoSetupRemote = true
[pull]
    rebase = true
[rebase]
    autoStash = true
[init]
    defaultBranch = main
[alias]
    tig = "!fn() { tig status; }; fn"
[include]
    path = .gitconfig-local
